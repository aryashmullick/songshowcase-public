# Server-only. Copy to .env.local and replace the Spotify placeholders.
SP_CLIENT_ID=your_spotify_client_id
SP_CLIENT_SECRET=your_spotify_client_secret
# Must exactly match a redirect URI registered in the Spotify developer dashboard.
SP_REDIRECT_URI=http://127.0.0.1:3000/api/callback
# Use a dedicated development database. Keep credentials out of Git.
DATABASE_URL=mongodb://127.0.0.1:27017/songshowcase
